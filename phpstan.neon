includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - phar://phpstan.phar/conf/bleedingEdge.neon
    - vendor/pestphp/pest-plugin-phpstan/extension.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon

parameters:
    parseModelCastsMethod: true

    paths:
        - app/
        - tests/
        - _ide_helper_models.php

    stubFiles:
        - stubs/LuaSandbox/Exceptions.php
        - stubs/LuaSandbox/LuaSandbox.php
        - stubs/LuaSandbox/LuaSandboxFunction.php

    level: 8

    ignoreErrors:
        -
            message: '#.*#'
            path: _ide_helper_models.php

        - '#Construct empty\(\) is not allowed.*#'
        - '#Short ternary operator is not allowed.*#'
        - '#Call to function base64_decode\(\).*#'
        - '#Dynamic call to static method Illuminate\\Http\\Request::validate\(\)#'

        # Larastan reflects every closure macro as static, but Filament's Livewire
        # testing helpers (fillForm, assertHasNoFormErrors, ...) are instance macros.
        -
            identifier: staticMethod.dynamicCall
            message: '#Livewire\\Features\\SupportTesting\\Testable#'
            path: tests/*
